{
  "name": "ar-flood-sim",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "check-data": "node scripts/check-data.mjs",
    "prebuild": "node scripts/check-data.mjs",
    "build": "vite build",
    "build:pages": "node scripts/check-data.mjs && vite build --mode pages",
    "deploy": "npm run build:pages && gh-pages -d dist --nojekyll -m \"Deploy to GitHub Pages\"",
    "preview": "vite preview --host",
    "preview:local": "vite build --mode http && vite preview --mode http --port 4173"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "three": "^0.186.1",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@iwer/sem": "^2.7.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "gh-pages": "^6.3.0",
    "iwer": "^2.7.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0"
  }
}
