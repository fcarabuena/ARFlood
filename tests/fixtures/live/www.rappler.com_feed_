]]></content:encoded>
					
					<wfw:commentRss>https://www.rappler.com/philippines/list-evidence-submitted-prosecution-impeachment-court-sara-duterte/feed/</wfw:commentRss>
			<slash:comments>0</slash:comments>
		
		
		
		<media:content url="https://www.youtube.com/embed/CcQSyB4t6mM" duration="231">
			<media:player url="https://www.youtube.com/embed/CcQSyB4t6mM" />
			<media:title type="html">LIST: Evidence submitted by prosecution to impeach court vs Sara Duterte</media:title>
			<media:description type="html">Rappler obtained a copy of the prosecution&#039;s formal offer of evidence. Here are key documents that are part of the submission.</media:description>
			<media:thumbnail url="https://www.rappler.com/tachyon/2026/10/ccqsyb4t6mm.jpg" />
